<markdown_cell>
# Quickstart: Generate Reports

This notebook demonstrates generating HTML/PDF reports from backtest results.
The PDF report now renders metrics, equity/drawdown charts, portfolio weights as a
bar chart, and the trade list as a table (multi-page for long trade logs).
</markdown_cell>

<code_cell>
from __future__ import annotations
from pathlib import Path
import pandas as pd
from backtest.engine import BacktestEngine
from strategies.mean_reversion import MeanReversionStrategy
from data.loader import DataLoader
from utils.reporting import generate_html_report, generate_pdf_report, generate_report

loader = DataLoader()
data = loader.load_data(['BTC'], '2024-01-01', '2024-02-01', freq='1h')
data = loader.clean_data(data)
engine = BacktestEngine(initial_capital=100000.0)
strat = MeanReversionStrategy(asset='BTC')
result = engine.run(strat, data)
print(generate_report(result))
</code_cell>

<code_cell>
# Attach trades + weights so the PDF renders the extra pages
result['trades'] = pd.DataFrame({
    'timestamp': pd.date_range('2024-01-01', periods=10, freq='12h'),
    'side': ['BUY', 'SELL'] * 5,
    'quantity': [1.0] * 10,
    'price': [100.0 + i for i in range(10)],
})
result['weights'] = pd.DataFrame({'BTC': [0.6, 0.4]})
print('trades:', len(result['trades']), 'rows; weights shape:', result['weights'].shape)
</code_cell>

<code_cell>
html = generate_html_report(result)
out_dir = Path('../reports')
out_dir.mkdir(parents=True, exist_ok=True)
(out_dir / 'report.html').write_text(html)
print('Saved reports/report.html')
</code_cell>

<code_cell>
pdf_path = generate_pdf_report(result, str(out_dir / 'report.pdf'), title='Quickstart Backtest Report')
print('Saved', pdf_path)
print('Size:', Path(pdf_path).stat().st_size, 'bytes')
</code_cell>