<markdown_cell>
# Walk-Forward Portfolio Report

Walks forward through train/test windows, aggregates per-window results into a
summary table, and renders per-window equity curves plus a chained equity curve
using :func:`utils.reporting.generate_walk_forward_report`.
</markdown_cell>

<code_cell>
from __future__ import annotations
from pathlib import Path
import pandas as pd
from data.loader import DataLoader
from utils.optimization import equal_weight
from utils.reporting import generate_walk_forward_report
from backtest.engine import BacktestEngine

loader = DataLoader()
data = loader.load_data(["BTC", "ETH", "SOL"], "2024-01-01", "2024-04-01", freq="1h")
data = loader.clean_data(data)

# Equal-weight portfolio across the three assets, rebalanced monthly.
weights = pd.DataFrame(
    equal_weight(3), index=data.index, columns=data.columns
)

engine = BacktestEngine(initial_capital=100_000.0)
wf = engine.walk_forward_portfolio(
    weights,
    data,
    train_period=240,
    test_period=120,
    rebalance_frequency="1w",
)
print("windows:", len(wf.get("results", [])))
print("mean_return:", wf.get("mean_return"))
print("total_periods:", wf.get("total_periods"))
</code_cell>

<code_cell>
report = generate_walk_forward_report(wf)
summary = report["summary"]
equity_curve = report["equity_curve"]
print(summary.to_string(index=False))
print("equity_curve points:", len(equity_curve))
</code_cell>

<code_cell>
import matplotlib.pyplot as plt

fig, axes = plt.subplots(2, 1, figsize=(10, 8), sharex=True)

# Per-window equity curves (each normalized to start at 1).
for idx, res in enumerate(wf.get("results", [])):
    ec = res.get("equity_curve")
    if ec is None:
        continue
    s = ec if isinstance(ec, pd.Series) else pd.Series(ec)
    if len(s) == 0:
        continue
    axes[0].plot(s.index, s / float(s.iloc[0]), label=f"Window {idx}", linewidth=1.0)
axes[0].set_ylabel("Normalized Equity")
axes[0].set_title("Per-Window Equity Curves")
axes[0].legend(fontsize=7, ncol=3)
axes[0].tick_params(labelsize=7)

# Chained equity curve from the aggregated report.
if len(equity_curve) > 0:
    axes[1].plot(equity_curve.index, equity_curve.values, label="Chained Equity", linewidth=1.2)
    axes[1].set_ylabel("Equity")
    axes[1].set_title("Chained Walk-Forward Equity Curve")
    axes[1].legend(fontsize=8)
    axes[1].tick_params(labelsize=7)

fig.tight_layout(pad=1.2)
plt.show()
</code_cell>

<code_cell>
# Save the summary table and chained equity curve as report artifacts.
out_dir = Path("../reports")
out_dir.mkdir(parents=True, exist_ok=True)
summary.to_csv(out_dir / "walk_forward_summary.csv")
equity_curve.to_csv(out_dir / "walk_forward_equity.csv")
print("Saved reports/walk_forward_summary.csv")
print("Saved reports/walk_forward_equity.csv")
</code_cell>
